<button class="trigger {{fullWidth ? 'full-width' : ''}}" hover-class="trigger-pressed" bindtap="open" disabled="{{disabled}}" aria-label="打开所有工具">所有工具<text class="trigger-mark">⌃</text></button>
<view wx:if="{{open}}" class="overlay" catchtouchmove="blockTouch">
  <view class="scrim" bindtap="close" aria-label="关闭工具抽屉"></view>
  <view class="sheet {{expanded ? 'expanded' : ''}}" aria-role="dialog" aria-label="所有工具" catchtap="blockTouch">
    <view class="drag-region" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragEnd"><view class="grabber"></view></view>
    <view class="sheet-header"><view class="sheet-title">所有工具</view><button class="close" hover-class="pressed" bindtap="close" aria-label="关闭工具抽屉">关闭</button></view>
    <view class="sheet-note">选择工具，开始创作。</view>
    <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="section-label">现在可用</view>
      <view class="group"><button wx:for="{{availableTools}}" wx:key="id" class="tool" data-id="{{item.id}}" bindtap="selectTool" hover-class="pressed" aria-label="{{item.title}}，{{item.note}}">
        <view class="format available">{{item.format}}</view>
        <view class="tool-copy"><view class="tool-title">{{item.title}}</view><view class="tool-note">{{item.note}}</view></view>
        <text class="current" wx:if="{{activeTool === item.id}}">当前</text><text class="chevron" wx:else>›</text>
      </button></view>
      <view class="section-label future-label">后续功能</view>
      <view class="group"><button wx:for="{{futureTools}}" wx:key="id" class="tool future" data-id="{{item.id}}" bindtap="selectTool" hover-class="pressed" aria-label="{{item.title}}，待开放">
        <view class="format">{{item.format}}</view>
        <view class="tool-copy"><view class="tool-title">{{item.title}}</view><view class="tool-note">{{item.note}}</view></view>
        <text class="future-status">待开放</text>
      </button></view>
      <view class="local-note">素材在本机处理，编辑结果请及时保存。</view>
    </scroll-view>
    <button class="expand-control" hover-class="pressed" bindtap="toggleExpanded">{{expanded ? '收起抽屉' : '展开抽屉'}}</button>
  </view>
</view>
