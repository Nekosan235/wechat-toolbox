:host { color: #1c1c1e; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button::after { border: none; }
button.trigger:not([size="mini"]) { box-sizing: border-box; width: auto; }
.trigger { min-height: 44px; min-width: 44px; padding: 0 14px; line-height: 44px; margin: 0; font-size: 15px; font-weight: 500; color: #0064d9; background: #e8eef8; border-radius: 22px; }
.trigger-mark { margin-left: 8px; font-size: 18px; }
button.trigger.full-width:not([size="mini"]) { width: 100%; }
.trigger.full-width { background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.04); }
.trigger-pressed { background: #d9e4f4; }
.trigger[disabled] { color: #636366; opacity: .55; }
.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 1000; }
.scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.28); animation: dim-in .18s ease-out; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; height: 66vh; min-height: 340px; max-height: 90vh; box-sizing: border-box; display: flex; flex-direction: column; border-radius: 28px 28px 0 0; background: #f2f2f7; padding: 0 20px 14px; padding-bottom: calc(14px + env(safe-area-inset-bottom)); box-shadow: 0 -8px 40px rgba(0,0,0,.1); animation: sheet-in .22s ease-out; transition: height .22s ease-out; }
.sheet.expanded { height: 88vh; }
.drag-region { height: 24px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.grabber { width: 36px; height: 5px; background: #b7b7bc; border-radius: 3px; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-shrink: 0; }
.sheet-title { font-size: 24px; font-weight: 600; letter-spacing: -.5px; }
button.close:not([size="mini"]) { width: auto; }
.close { flex-shrink: 0; margin: 0 -8px 0 0; padding: 0 12px; min-width: 44px; min-height: 44px; line-height: 44px; font-size: 16px; color: #0064d9; border-radius: 22px; background: transparent; }
.sheet-note { font-size: 14px; color: #636366; margin: 0 0 12px; }
.sheet-body { flex: 1; min-height: 0; height: 0; }
.section-label { font-size: 14px; color: #636366; margin: 6px 12px 8px; }
.future-label { margin-top: 22px; }
.group { border-radius: 18px; overflow: hidden; background: #fff; }
button.tool:not([size="mini"]) { box-sizing: border-box; width: 100%; }
.tool { display: flex; align-items: center; text-align: left; gap: 12px; margin: 0; padding: 16px 14px; line-height: normal; min-height: 76px; background: #fff; color: #1c1c1e; border-radius: 0; border-bottom: .5px solid #e5e5ea; }
.tool:last-child { border-bottom: none; }
.format { width: 44px; height: 44px; line-height: 44px; border-radius: 12px; flex-shrink: 0; text-align: center; font-size: 13px; font-weight: 600; color: #636366; background: #f2f2f7; }
.format.available { color: #0064d9; background: #edf3ff; }
.tool-copy { flex: 1; min-width: 0; }
.tool-title { font-size: 17px; font-weight: 500; }
.tool-note { margin-top: 5px; font-size: 14px; line-height: 1.45; color: #636366; white-space: normal; }
.chevron { font-size: 27px; color: #636366; }
.current { font-size: 13px; color: #0064d9; flex-shrink: 0; }
.future-status { font-size: 12px; color: #636366; background: #f2f2f7; padding: 5px 7px; border-radius: 7px; flex-shrink: 0; }
.local-note { padding: 16px 12px; font-size: 14px; color: #636366; line-height: 1.5; }
button.expand-control:not([size="mini"]) { width: 100%; }
.expand-control { flex-shrink: 0; min-height: 44px; line-height: 44px; border-radius: 16px; font-size: 15px; color: #0064d9; margin: 8px 0 0; background: #e8eef8; }
.pressed { background: #e9e9ee; }
.trigger.full-width.trigger-pressed { background: #d9e4f4; }
@keyframes sheet-in { from { transform: translateY(32px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes dim-in { from { opacity: 0; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .sheet, .scrim { animation: none; transition: none; } }
